[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://addons/dialogue_flow/bin/linux/libdialogue_flow.debug.so"
linux.release.x86_64 =   "res://addons/dialogue_flow/bin/linux/libdialogue_flow.release.so"
windows.debug.x86_64 =   "res://addons/dialogue_flow/bin/windows/dialogue_flow.debug.dll"
windows.release.x86_64 = "res://addons/dialogue_flow/bin/windows/dialogue_flow.release.dll"
macos.debug =            "res://addons/dialogue_flow/bin/macos/libdialogue_flow.debug.dylib"
macos.release =          "res://addons/dialogue_flow/bin/macos/libdialogue_flow.release.dylib"
macos.debug.arm64 =      "res://addons/dialogue_flow/bin/macos/libdialogue_flow.debug.dylib"
macos.release.arm64 =    "res://addons/dialogue_flow/bin/macos/libdialogue_flow.release.dylib"
