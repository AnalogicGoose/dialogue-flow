# Godot 4+
dialogue-flow-godot/.godot/
dialogue-flow-godot/android/

# Compiled GDExtension binaries -- regenerated by `cargo build-addon` (see
# dialogue-flow-rust/src/bin/build_addon.rs), not hand-edited. Committed
# separately (e.g. per release/tag) rather than on every commit during dev.
# bin/* + a negated .gdignore, not a bare "bin/", so the marker file that
# tells the Godot editor to skip scanning this folder still gets tracked --
# negating a path inside a wholesale-ignored directory doesn't work in git.
dialogue-flow-godot/addons/dialogue_flow/bin/*
!dialogue-flow-godot/addons/dialogue_flow/bin/.gdignore

# Rust
dialogue-flow-rust/target/
dialogue-flow-rust/.idea/

# CodeGraph local index
.codegraph/
